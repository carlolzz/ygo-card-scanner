# Miscellaneous
*.class
*.log
*.pyc
*.swp
__pycache__/
.pytest_cache/
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/android/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Generated code (freezed / json_serializable / riverpod_generator)
**/*.freezed.dart
**/*.g.dart

# build_hash_index.py local image cache (large, regenerable from YGOPRODeck).
# The generated assets/card_hashes.json is committed; the cached art is not.
tools/.image_cache/

# Android release signing — never commit the keystore or its passwords.
# key.properties.example (the committed template) is kept: it is a different
# filename, so the pattern below does not match it.
android/key.properties
**/key.properties
*.jks
*.keystore
/android/local.properties
